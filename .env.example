# Neon, branch dev, COM pooling (endereço com -pooler)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon, branch dev, conexão DIRETA (sem -pooler) - usada nas migrações
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave secreta do Better Auth
BETTER_AUTH_SECRET="sua_chave_secret_aqui"

# URL base da aplicação
BETTER_AUTH_URL="http://localhost:3000"

# Token do Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_seu_token_aqui"

# E-mails dos administradores, separados por vírgula (opcional: o padrão já é este)
ADMIN_EMAILS="admin1@versusos.com,admin2@versusos.com"

# Senha inicial das contas admin criadas pelo seed (opcional, de 8 a 72 caracteres).
# Em produção, defina uma senha forte aqui antes de rodar o seed.
ADMIN_SEED_PASSWORD=""
