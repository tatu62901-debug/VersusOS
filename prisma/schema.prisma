generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  bannedAt      DateTime? // preenchido quando um admin suspende a conta
  banReason     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  teams         Team[]
  players       Player[]
  joinRequests  JoinRequest[]
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
  @@map("verification")
}

// Time de e-sports. O "dono" (userId) é quem criou e gerencia o time.
model Team {
  id            String         @id @default(cuid())
  name          String         @unique
  game          String
  logoUrl       String?
  description   String?
  inviteCode    String         @unique // código que o dono passa pra outras pessoas entrarem no time
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  players       Player[]
  registrations Registration[]
  joinRequests  JoinRequest[]
  partidasComoA Match[]          @relation("PartidaTimeA")
  partidasComoB Match[]          @relation("PartidaTimeB")
  @@map("teams")
}

// Jogador do elenco de um time. Se userId estiver preenchido, o jogador é uma
// conta que entrou no time pelo código; se for null, foi cadastrado pelo dono.
model Player {
  id        String   @id @default(cuid())
  nickname  String
  role      String
  age       Int
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@unique([teamId, userId])
  @@map("players")
}

// Campeonato. Os dados iniciais vêm do seed (prisma/seed.ts) e o admin gerencia pelo site.
// status: INSCRICOES -> EM_ANDAMENTO -> ENCERRADO (ou CANCELADO)
model Tournament {
  id                   String         @id @default(cuid())
  name                 String         @unique
  game                 String
  description          String?
  prize                Int // premiação em reais
  maxTeams             Int
  startDate            DateTime // data de início prevista
  registrationDeadline DateTime // prazo final das inscrições
  status               String         @default("INSCRICOES")
  championName         String? // preenchidos quando a final é decidida
  runnerUpName         String?
  imageUrl             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  registrations        Registration[]
  matches              Match[]
  @@map("tournaments")
}

// Inscrição de um time em um campeonato (relação N para N entre Team e Tournament).
model Registration {
  id           String     @id @default(cuid())
  status       String     @default("PENDENTE") // PENDENTE ou APROVADA (o admin aprova)
  createdAt    DateTime   @default(now())
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@unique([teamId, tournamentId])
  @@map("registrations")
}

// Pedido de entrada em um time. O dono do time aprova (vira Player) ou recusa.
model JoinRequest {
  id        String   @id @default(cuid())
  status    String   @default("PENDENTE") // PENDENTE ou RECUSADO
  nickname  String
  role      String
  age       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@map("join_requests")
}

// Tentativas de login que falharam (usadas para limitar tentativas).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())
  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// Registro das ações feitas pelos administradores (auditoria).
// Guarda cópias do nome/e-mail do admin e do alvo, pra o histórico continuar legível
// mesmo se a conta ou o item for apagado depois.
model AdminLog {
  id         String   @id @default(cuid())
  action     String // ex: JOGADOR_REMOVIDO, TIME_EXCLUIDO
  targetName String
  reason     String?
  teamId     String? // quando a ação mexe em um time, para o dono ver o aviso
  adminName  String
  adminEmail String
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([teamId])
  @@map("admin_logs")
}

// Partida do chaveamento (mata-mata). Os nomes dos times são copiados para a partida
// pra o histórico continuar certo mesmo se um time for excluído depois.
model Match {
  id           String     @id @default(cuid())
  round        Int // 1 = primeira rodada ... última = final
  position     Int
  teamAId      String?
  teamAName    String?
  teamBId      String?
  teamBName    String?
  scoreA       Int?
  scoreB       Int?
  winnerSide   String? // "A" ou "B"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA        Team?      @relation("PartidaTimeA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB        Team?      @relation("PartidaTimeB", fields: [teamBId], references: [id], onDelete: SetNull)
  @@unique([tournamentId, round, position])
  @@map("matches")
}
